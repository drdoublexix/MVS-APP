{
  "expo": {
    "name": "MVS",
    "slug": "mvs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-background.png",
    "userInterfaceStyle": "light",
    "scheme": "mvsapp",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "739602ef-f2b2-49fb-8f3d-ec13cd46a4e3"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.mvs.app",
      "supportsTablet": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "MVS needs access to your location to find nearby veterinarians.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MVS needs access to your location to find nearby veterinarians.",
        "UIRequiredDeviceCapabilities": [
          "location-services"
        ]
      }
    },
    "android": {
      "package": "com.mvs.app",
      "versionCode": 100,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#08111F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mvsapp.com.ng",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "mvsapp.com.ng",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "name": "MVS",
      "shortName": "MVS",
      "lang": "en",
      "description": "MVS connects pet owners, vets, and merchants in a modern pet care marketplace.",
      "display": "standalone",
      "orientation": "portrait",
      "backgroundColor": "#08111F",
      "themeColor": "#08111F",
      "startUrl": "/",
      "favicon": "./assets/images/favicon.jpeg"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MVS to access your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/mvs-notification-icon.png",
          "color": "#10b981"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MVS to record voice notes."
        }
      ],
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      "expo-video",
      "expo-asset",
      "expo-sharing",
      "expo-maps"
    ],
    "owner": "drdoublexix"
  }
}
